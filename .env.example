# Copy to .env (never commit .env) and fill in your own values.
GEMINI_API_KEY=
HF_TOKEN=

# Gemini labelling settings (not secret)
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_MODE=verbatim

# Hugging Face models (not secret)
ASR_MODEL_REPO=bodhan-ai/indic-transcribe-core
ASR_BASELINE_REPO=ai4bharat/indic-conformer-600m-multilingual
